# Put your real secrets here. Do NOT commit this file to git.
# Example values shown; replace with your actual tokens and DB URL.

# Set to 'development' to use local DB defaults. Set to 'production' for remote DB.
APP_ENV=development

TELEGRAM_BOT_TOKEN=
GOOGLE_API_KEY=
DB_HOST=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-flash-lite-latest
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Optional tuning (these match defaults in Settings)
DB_MIN_POOL_SIZE=1
DB_MAX_POOL_SIZE=10
DB_STATEMENT_CACHE_SIZE=0
DB_COMMAND_TIMEOUT=30
RUN_SCHEMA_INIT_ON_STARTUP=true
DEFAULT_TIMEZONE=UTC
MAX_PHOTO_BYTES=8388608
HISTORY_TURNS_KEPT=12
HISTORY_TTL_SECONDS=1800
AGENT_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO
